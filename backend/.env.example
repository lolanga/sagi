APP_NAME=SAGI
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://tu-servicio.up.railway.app

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_AR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Railway: usar el plugin Postgres -> DB_CONNECTION=pgsql
# Si el plugin genera DATABASE_URL, el entrypoint expande las variables de arriba solo.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=railway
DB_USERNAME=postgres
DB_PASSWORD=

# Usuarios de prueba (admin/Admin1234, jefe/Jefe1234, etc.).
# NUNCA activar en produccion: quedan deshabilitados por defecto.
APP_SEED_DEMO_USERS=false

# 20 items de ejemplo repartidos en A1-A6. Sirve para mostrar la aplicacion;
# NUNCA activar en produccion. No se repite si ya estan cargados.
APP_SEED_DEMO_ITEMS=false

# Administrador inicial: solo se usa cuando la base esta vacia y
# APP_SEED_DEMO_USERS=false. Luego se cambia la clave desde la aplicacion.
APP_ADMIN_NAME="Administrador"
APP_ADMIN_USERNAME=
APP_ADMIN_DNI=
APP_ADMIN_EMAIL=
APP_ADMIN_PASSWORD=

# Cache y cola: Postgres es suficiente para este volumen.
# Si el trafico crece, cambiar a redis.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@isepsantafe.net.ar"
MAIL_FROM_NAME="${APP_NAME}"

# Origenes permitidos por CORS (frontend en otro dominio)
CORS_ALLOWED_ORIGINS=https://tu-frontend.vercel.app

VITE_APP_NAME="${APP_NAME}"
