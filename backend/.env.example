APP_NAME=SAGI
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://tu-servicio.up.railway.app

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_AR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Railway: usar el plugin Postgres -> DB_CONNECTION=pgsql
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=railway
DB_USERNAME=postgres
DB_PASSWORD=

# Cache y cola: Postgres es suficiente para este volumen.
# Si el trafico crece, cambiar a redis.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@isepsantafe.net.ar"
MAIL_FROM_NAME="${APP_NAME}"

# Origenes permitidos por CORS (frontend en otro dominio)
CORS_ALLOWED_ORIGINS=https://tu-frontend.vercel.app

VITE_APP_NAME="${APP_NAME}"
